# ---- Zang P4 defaults for board v0.0.1. Board pins: menuconfig -> "Zang board pins" (defaults = schematic).
CONFIG_IDF_TARGET="esp32p4"

# Flash / partitions: schematic IC2 = W25Q128JVSIQ = 128 Mbit = 16 MB
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y

# Console on USB-Serial-JTAG (GPIO24/25). UART0 = GPIO37/38 straps are left untouched.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# CPU / RTOS
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_MALLOC=y

# ---- Wireless through the ESP32-C2 (ESP8684) co-processor: ESP-Hosted over UART (v0.0.1 wires UART only) ----
CONFIG_ESP_WIFI_REMOTE_LIBRARY_HOSTED=y
CONFIG_SLAVE_IDF_TARGET_ESP32C2=y
CONFIG_ESP_HOSTED_CP_TARGET_ESP32C2=y
CONFIG_ESP_HOSTED_UART_HOST_INTERFACE=y
# Must equal CONFIG_ZANG_PIN_C2_* (components/net checks it at compile time) and zang_c2_hosted's baud rate.
CONFIG_ESP_HOSTED_UART_PORT=2
CONFIG_ESP_HOSTED_UART_PIN_TX=27
CONFIG_ESP_HOSTED_UART_PIN_RX=26
CONFIG_ESP_HOSTED_UART_GPIO_RESET_SLAVE=29
CONFIG_ESP_HOSTED_UART_RESET_ACTIVE_HIGH=y
CONFIG_ESP_HOSTED_UART_BAUDRATE=3000000
CONFIG_ESP_HOSTED_CLI_ENABLED=n

# Networking
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_MDNS_MAX_SERVICES=4

# ---- Camera: OV2640 (assumed, VERIFY the module) over DVP; formats used by components/camera ----
CONFIG_CAMERA_OV2640=y
CONFIG_CAMERA_OV2640_AUTO_DETECT_DVP_INTERFACE_SENSOR=y
# JPEG only: the sensor compresses; CMD CAMERA_STREAM picks QVGA or VGA at run time (components/camera)
CONFIG_CAMERA_OV2640_DVP_JPEG_320X240_50FPS=y
CONFIG_CAMERA_OV2640_DVP_JPEG_640X480_25FPS=y
CONFIG_CAMERA_OV2640_DVP_DEFAULT_FMT_JPEG_320X240_50FPS=y
