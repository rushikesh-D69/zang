{
  "_doc": "CANONICAL face library for Zang's chest TFT (round 240x240). Shared contract: the Python reference renderer (zang_ai/face/render.py), the studio (web/face.js) and the P4 firmware (components/display/face_sdf.c) all draw these SAME parameters with the SAME signed-distance algorithm. Coordinates are panel pixels, origin = panel centre, +y DOWN. Emotion ids are the wire ids of ZLink FACE_SET (index in 'emotions' order; never reorder, only append). Golden renders for the firmware test: tools/gen_face_goldens.py.",
  "panel": {"w": 240, "h": 240, "round": true, "bg": [4, 6, 10]},
  "params": [
    {"id": 0,  "name": "eye_open",    "min": 0,    "max": 1,   "doc": "1 = fully open, 0 = closed line"},
    {"id": 1,  "name": "eye_w",       "min": 10,   "max": 70,  "doc": "eye width px"},
    {"id": 2,  "name": "eye_h",       "min": 6,    "max": 90,  "doc": "eye height px when open"},
    {"id": 3,  "name": "eye_round",   "min": 0,    "max": 1,   "doc": "corner radius as fraction of min(w,h)/2"},
    {"id": 4,  "name": "eye_dx",      "min": 20,   "max": 80,  "doc": "half distance between eye centres px"},
    {"id": 5,  "name": "eye_y",       "min": -60,  "max": 30,  "doc": "eye centre y px"},
    {"id": 6,  "name": "lid_angle",   "min": -40,  "max": 40,  "doc": "upper-lid slant deg; + = inner corners down (angry), - = inner corners up (sad)"},
    {"id": 7,  "name": "lid_top",     "min": 0,    "max": 1,   "doc": "fraction of the eye covered by the slanted upper lid"},
    {"id": 8,  "name": "lid_bot",     "min": 0,    "max": 1,   "doc": "happy squint: an arc pushes up from below, fraction of eye height"},
    {"id": 9,  "name": "gaze_x",      "min": -30,  "max": 30,  "doc": "eye shift px (+ = viewer's right)"},
    {"id": 10, "name": "gaze_y",      "min": -25,  "max": 25,  "doc": "eye shift px (+ = down)"},
    {"id": 11, "name": "brow",        "min": 0,    "max": 1,   "doc": "brow visibility"},
    {"id": 12, "name": "brow_y",      "min": -40,  "max": 0,   "doc": "brow height above the eye top px"},
    {"id": 13, "name": "brow_angle",  "min": -35,  "max": 35,  "doc": "deg; + = inner ends down (angry)"},
    {"id": 14, "name": "mouth_w",     "min": 0,    "max": 110, "doc": "mouth width px (0 = no mouth)"},
    {"id": 15, "name": "mouth_y",     "min": 20,   "max": 90,  "doc": "mouth centre y px"},
    {"id": 16, "name": "mouth_curve", "min": -1,   "max": 1,   "doc": "+ smile, - frown"},
    {"id": 17, "name": "mouth_open",  "min": 0,    "max": 1,   "doc": "0 = line, 1 = open oval (speech drives this)"},
    {"id": 18, "name": "mouth_thick", "min": 3,    "max": 14,  "doc": "line thickness px"},
    {"id": 19, "name": "blush",       "min": 0,    "max": 1,   "doc": "cheek blush strength"},
    {"id": 20, "name": "symbol",      "min": 0,    "max": 5,   "doc": "0 none, 1 hearts (eyes), 2 X eyes, 3 zzz, 4 tear, 5 sparkle"},
    {"id": 21, "name": "hue",         "min": 0,    "max": 360, "doc": "ink hue deg (ink = hsv(hue, sat, 1))"},
    {"id": 22, "name": "sat",         "min": 0,    "max": 1,   "doc": "ink saturation (0 = white)"}
  ],
  "base": {"eye_open": 1, "eye_w": 38, "eye_h": 56, "eye_round": 0.9, "eye_dx": 44, "eye_y": -18, "lid_angle": 0,
           "lid_top": 0, "lid_bot": 0, "gaze_x": 0, "gaze_y": 0, "brow": 0, "brow_y": -14, "brow_angle": 0,
           "mouth_w": 46, "mouth_y": 48, "mouth_curve": 0.25, "mouth_open": 0, "mouth_thick": 7, "blush": 0,
           "symbol": 0, "hue": 192, "sat": 0.7},
  "emotions": [
    {"name": "neutral",    "p": {}},
    {"name": "happy",      "p": {"lid_bot": 0.35, "mouth_curve": 0.8, "mouth_w": 60}},
    {"name": "joy",        "p": {"lid_bot": 0.55, "mouth_curve": 1, "mouth_open": 0.6, "mouth_w": 70, "blush": 0.6, "hue": 175}},
    {"name": "excited",    "p": {"eye_h": 64, "eye_w": 42, "mouth_curve": 0.9, "mouth_open": 0.8, "mouth_w": 64, "symbol": 5, "hue": 48, "sat": 0.85}},
    {"name": "sad",        "p": {"lid_angle": -22, "lid_top": 0.35, "eye_y": -10, "mouth_curve": -0.7, "mouth_w": 44, "gaze_y": 6, "hue": 215, "sat": 0.8}},
    {"name": "crying",     "p": {"lid_angle": -25, "lid_top": 0.4, "eye_y": -10, "mouth_curve": -0.9, "mouth_open": 0.3, "symbol": 4, "hue": 210, "sat": 0.85}},
    {"name": "angry",      "p": {"lid_angle": 28, "lid_top": 0.38, "brow": 1, "brow_angle": 28, "mouth_curve": -0.6, "mouth_w": 50, "hue": 4, "sat": 0.9}},
    {"name": "surprised",  "p": {"eye_h": 72, "eye_w": 46, "eye_round": 1, "brow": 1, "brow_y": -22, "mouth_w": 30, "mouth_open": 1, "mouth_curve": 0}},
    {"name": "scared",     "p": {"eye_h": 66, "eye_w": 30, "lid_angle": -14, "lid_top": 0.15, "brow": 1, "brow_angle": -22, "brow_y": -18, "mouth_curve": -0.4, "mouth_open": 0.35, "mouth_w": 40, "hue": 260, "sat": 0.5}},
    {"name": "thinking",   "p": {"gaze_x": -14, "gaze_y": -16, "lid_top": 0.2, "lid_angle": 8, "brow": 1, "brow_angle": -12, "mouth_curve": -0.15, "mouth_w": 30}},
    {"name": "confused",   "p": {"lid_angle": 14, "lid_top": 0.18, "brow": 1, "brow_angle": -18, "mouth_curve": -0.3, "mouth_w": 36, "gaze_x": 8, "hue": 280, "sat": 0.45}},
    {"name": "sleepy",     "p": {"eye_open": 0.12, "lid_bot": 0, "mouth_curve": 0.1, "mouth_w": 26, "symbol": 3, "hue": 230, "sat": 0.4}},
    {"name": "love",       "p": {"symbol": 1, "mouth_curve": 0.9, "mouth_w": 56, "blush": 0.8, "hue": 335, "sat": 0.75}},
    {"name": "shy",        "p": {"lid_bot": 0.3, "gaze_x": 16, "gaze_y": 12, "blush": 1, "mouth_curve": 0.5, "mouth_w": 28, "hue": 340, "sat": 0.5}},
    {"name": "proud",      "p": {"lid_bot": 0.42, "lid_top": 0.12, "mouth_curve": 0.7, "mouth_w": 52, "gaze_y": -4, "hue": 45, "sat": 0.7}},
    {"name": "listening",  "p": {"eye_h": 60, "gaze_y": -2, "mouth_w": 22, "mouth_curve": 0.2, "brow": 1, "brow_y": -16, "brow_angle": -6}},
    {"name": "calm",       "p": {"eye_open": 0.35, "lid_bot": 0.25, "mouth_curve": 0.45, "mouth_w": 40, "hue": 160, "sat": 0.55}},
    {"name": "determined", "p": {"lid_angle": 14, "lid_top": 0.25, "brow": 1, "brow_angle": 14, "mouth_curve": 0.05, "mouth_w": 46, "mouth_thick": 9}},
    {"name": "dizzy",      "p": {"symbol": 2, "mouth_curve": -0.2, "mouth_open": 0.25, "mouth_w": 34, "hue": 120, "sat": 0.5}},
    {"name": "bored",      "p": {"lid_top": 0.48, "lid_angle": 0, "gaze_x": 12, "mouth_curve": -0.1, "mouth_w": 34}},
    {"name": "wink",       "p": {"lid_bot": 0.3, "mouth_curve": 0.85, "mouth_w": 58, "_wink": 1}}
  ],
  "_mapping_doc": "How the composer picks faces: a base emotion from the LLM mood (valence/arousal), then gesture-specific expressions over each semantic gesture's span. Speech drives mouth_open; blinks and micro-gaze come from the renderer's idle layer.",
  "from_gesture": {
    "wave": "happy", "namaste": "calm", "self": "proud", "thanks": "happy", "sorry": "sad", "point": "determined",
    "there": "neutral", "up": "excited", "come": "happy", "open": "happy", "explain": "neutral", "count": "thinking",
    "big": "surprised", "small": "shy", "think": "thinking", "listen": "listening", "stop": "determined",
    "shrug": "confused", "heart": "love", "proud": "proud", "shy": "shy", "surprise": "surprised", "laugh": "joy",
    "excited": "excited", "celebrate": "excited", "sad": "sad", "calm": "calm", "down": "neutral", "away": "angry",
    "rain": "sad", "sun": "joy", "round": "dizzy", "fly": "excited", "sleep": "sleepy", "clap": "joy", "run": "excited",
    "music": "joy", "bow": "calm", "flex": "proud", "no": "determined", "yes": "happy", "question": "confused",
    "emphasis": "determined"
  },
  "from_mood": [
    {"if": "valence>=0.75 and arousal>=0.65", "emotion": "excited"},
    {"if": "valence>=0.7",                    "emotion": "happy"},
    {"if": "valence<=0.25 and arousal>=0.65", "emotion": "angry"},
    {"if": "valence<=0.3 and arousal<=0.4",   "emotion": "sad"},
    {"if": "valence<=0.35",                   "emotion": "confused"},
    {"if": "arousal<=0.25",                   "emotion": "calm"},
    {"if": "true",                            "emotion": "neutral"}
  ]
}
